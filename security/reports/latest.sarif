{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "rules": [
            {
              "id": "security.dns-tool-tls-skip-verify-untagged",
              "shortDescription": {
                "text": "TLS certificate verification is disabled. If this is intentional for a security diagnostic tool, add a SECINTENT tag and register in security/security-intents.yaml. Otherwise, enable verification.\n"
              }
            },
            {
              "id": "go.lang.security.audit.crypto.missing-ssl-minversion.missing-ssl-minversion",
              "shortDescription": {
                "text": "`MinVersion` is missing from this TLS configuration.  By default, as of Go 1.22, TLS 1.2 is currently used as the minimum. General purpose web applications should default to TLS 1.3 with all other pro"
              }
            },
            {
              "id": "security.dns-tool-raw-redirect-no-wrapper",
              "shortDescription": {
                "text": "Direct use of c.Redirect() detected. For user-controlled or external URLs, prefer safe redirect wrappers that validate the target URL against an allowlist. Internal redirects to hardcoded paths are ac"
              }
            },
            {
              "id": "go.lang.security.deserialization.unsafe-deserialization-interface.go-unsafe-deserialization-interface",
              "shortDescription": {
                "text": "Deserializing into `interface{}` allows arbitrary data structures and types, which can lead to security vulnerabilities (CWE-502). Use a concrete struct type instead. Consider using github.com/ravisas"
              }
            },
            {
              "id": "go.lang.security.audit.net.cookie-missing-httponly.cookie-missing-httponly",
              "shortDescription": {
                "text": "A session cookie was detected without setting the 'HttpOnly' flag. The 'HttpOnly' flag for cookies instructs the browser to forbid client-side scripts from reading the cookie which mitigates XSS attac"
              }
            },
            {
              "id": "go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure",
              "shortDescription": {
                "text": "A session cookie was detected without setting the 'Secure' flag. The 'secure' flag for cookies prevents the client from transmitting the cookie over insecure channels such as HTTP. Set the 'Secure' fl"
              }
            },
            {
              "id": "go.lang.security.audit.net.formatted-template-string.formatted-template-string",
              "shortDescription": {
                "text": "Found a formatted template string passed to 'template.HTML()'. 'template.HTML()' does not escape contents. Be absolutely sure there is no user-controlled data in this template. If user data can reach "
              }
            },
            {
              "id": "html.security.plaintext-http-link.plaintext-http-link",
              "shortDescription": {
                "text": "This link points to a plaintext HTTP URL. Prefer an encrypted HTTPS URL if possible."
              }
            }
          ]
        }
      },
